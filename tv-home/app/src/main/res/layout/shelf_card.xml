<?xml version="1.0" encoding="utf-8"?>
<!-- A shelf card: 16:9 artwork, the title over a bottom fade, and a progress bar for Continue watching.
     Size set in code (shelf_card_width). The white ring shows only while focused. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="168dp"
    android:layout_height="94dp"
    android:layout_marginEnd="14dp"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/shelf_card_bg"
    android:foreground="@drawable/shelf_card_ring"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/shelfImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:background="@drawable/shelf_card_scrim" />

    <TextView
        android:id="@+id/shelfTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        android:layout_marginBottom="9dp"
        android:fontFamily="@string/font_medium"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:shadowColor="#99000000"
        android:shadowRadius="4" />

    <FrameLayout
        android:id="@+id/shelfProgress"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/shelf_progress_track"
        android:visibility="gone">

        <View
            android:id="@+id/shelfProgressFill"
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:background="@drawable/shelf_progress_fill" />
    </FrameLayout>
</FrameLayout>
